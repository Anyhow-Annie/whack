# Copy to .env.local and fill from Firebase console → Project settings → Your apps.
# Leave these blank to run the local preview. The UI then uses sample data in the browser
# and does not call Firebase. Fill them in when you want the real project.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true only when running `firebase emulators:start`. Never enable this in production.
VITE_USE_FIREBASE_EMULATORS=false

# AI provider keys belong in Cloud Functions secrets, not in this file.
# Do not add GEMINI_API_KEY or OPENAI_API_KEY with a VITE_ prefix.
