rules_version = '2';

// Access to organizational knowledge depends on the custom claim `role`.
// Clients cannot write that claim. Cloud Functions set it with the Admin SDK
// after checking the caller's existing claim. A self-created employee profile
// can only be role "viewer", and that directory value does not grant access.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return signedIn() && request.auth.token.role in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function canManage() {
      return hasRole(['admin', 'manager']);
    }

    function canContribute() {
      return hasRole(['admin', 'manager', 'member']);
    }

    function canReadKnowledge() {
      return hasRole(['admin', 'manager', 'member', 'viewer']);
    }

    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function isProjectMember(projectId) {
      return signedIn() && (
        isAdmin()
        || request.auth.uid == project(projectId).ownerId
        || request.auth.uid in project(projectId).memberIds
      );
    }

    match /meta/{docId} {
      allow read, write: if false;
    }

    match /employees/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'title', 'department', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'viewer'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() < 120
        && request.resource.data.title is string
        && request.resource.data.title.size() < 120
        && request.resource.data.department is string
        && request.resource.data.department.size() < 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'title', 'department', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() < 120
        && request.resource.data.title is string
        && request.resource.data.title.size() < 120
        && request.resource.data.department is string
        && request.resource.data.department.size() < 120
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /projects/{projectId} {
      allow read: if canReadKnowledge();

      allow create: if canManage()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'status', 'ownerId', 'memberIds', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() > 0
        && request.resource.data.memberIds.size() < 200
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.description is string
        && request.resource.data.description.size() < 4000
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canManage()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds is list
        && request.resource.data.ownerId in request.resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'status', 'memberIds', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.description is string
        && request.resource.data.description.size() < 4000
        && request.resource.data.status in ['active', 'archived']
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /documents/{documentId} {
      allow read: if canReadKnowledge();

      allow create: if canContribute()
        && isProjectMember(request.resource.data.projectId)
        && request.resource.data.keys().hasOnly([
          'projectId', 'title', 'fileName', 'storagePath', 'contentType', 'size', 'uploadedBy', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.projectId.matches('^[A-Za-z0-9]+$')
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() < 200
        && request.resource.data.storagePath.matches(
          '^documents/' + request.resource.data.projectId + '/' + documentId + '/[^/]+$'
        )
        && request.resource.data.contentType.matches('^(text/.+|application/pdf|application/json)$')
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size < 20 * 1024 * 1024
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canContribute()
        && isProjectMember(resource.data.projectId)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'uploaded'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /knowledgeChunks/{chunkId} {
      allow read: if canReadKnowledge();
      allow write: if false;
    }

    match /projectUpdates/{updateId} {
      allow read: if canReadKnowledge();

      allow create: if canContribute()
        && isProjectMember(request.resource.data.projectId)
        && request.resource.data.keys().hasOnly([
          'projectId', 'authorId', 'authorName', 'body', 'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() < 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() < 8000
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /knowledgeRelationships/{relationshipId} {
      allow read: if canReadKnowledge();

      allow create: if canManage()
        && request.resource.data.keys().hasOnly([
          'fromType', 'fromId', 'toType', 'toId', 'kind', 'createdBy', 'createdAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.fromType in ['project', 'document', 'chunk', 'employee']
        && request.resource.data.toType in ['project', 'document', 'chunk', 'employee']
        && request.resource.data.fromId is string
        && request.resource.data.toId is string
        && request.resource.data.fromId.size() < 200
        && request.resource.data.toId.size() < 200
        && request.resource.data.kind in ['related', 'depends_on', 'continues', 'references']
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if canManage();
    }
  }
}
